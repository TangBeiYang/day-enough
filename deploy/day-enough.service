[Unit]
Description=DayEnough personal task planner
After=network.target

[Service]
User=dayenough
Group=dayenough
WorkingDirectory=/opt/day-enough
Environment=DAY_ENOUGH_DATA=/var/lib/day-enough
Environment=DAY_ENOUGH_SECURE_COOKIE=1
ExecStart=/opt/day-enough/.venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:8000 --access-logfile - day_enough:create_app()
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/day-enough

[Install]
WantedBy=multi-user.target
