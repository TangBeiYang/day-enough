[Unit]
Description=Daily DayEnough account backup

[Service]
Type=oneshot
User=dayenough
Group=dayenough
WorkingDirectory=/opt/day-enough
Environment=DAY_ENOUGH_DATA=/var/lib/day-enough
ExecStart=/bin/sh -c 'exec .venv/bin/flask --app day_enough backup "/var/lib/day-enough/backups/day-enough-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).zip"'
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/day-enough
